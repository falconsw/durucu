      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv yeniden yazılır ve şifreli dosyalar AES-256 ile yeniden şifrelenir. Önceki sürüm Çöp Sepeti'ne taşınır."
